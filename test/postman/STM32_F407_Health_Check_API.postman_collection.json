{
  "info": {
    "_postman_id": "a7ed9183-c25b-4ec7-8fc4-df47ca130010",
    "name": "STM32 F407 Health Check API",
    "description": "End-to-end authorization, user, health-check, telemetry, log, and TLS credential tests. Set secret password variables and DER file paths locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "https://192.168.0.50"},
    {"key": "masterUsername", "value": "master"},
    {"key": "masterPassword", "value": "", "type": "secret"},
    {"key": "accessToken", "value": "", "type": "secret"},
    {"key": "refreshToken", "value": "", "type": "secret"},
    {"key": "testUsername", "value": "operator"},
    {"key": "testPassword", "value": "", "type": "secret"},
    {"key": "resourceIndex", "value": ""},
    {"key": "certificateDerPath", "value": "TLS/Private/management_server.crt.der"},
    {"key": "privateKeyDerPath", "value": "TLS/Private/management_server.key.der"}
  ],
  "item": [
    {
      "name": "Request token",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Login succeeded\", () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.token_type).to.eql(\"Bearer\");",
        "pm.collectionVariables.set(\"accessToken\", body.access_token);",
        "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{masterUsername}}\",\n  \"password\": \"{{masterPassword}}\"\n}"},
        "url": "{{baseUrl}}/api/v1/auth/token"
      }
    },
    {
      "name": "Refresh token",
      "event": [{"listen": "test", "script": {"exec": [
        "const oldAccess = pm.collectionVariables.get(\"accessToken\");",
        "const oldRefresh = pm.collectionVariables.get(\"refreshToken\");",
        "pm.test(\"Refresh succeeded\", () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.access_token).to.not.eql(oldAccess);",
        "pm.expect(body.refresh_token).to.not.eql(oldRefresh);",
        "pm.collectionVariables.set(\"accessToken\", body.access_token);",
        "pm.collectionVariables.set(\"refreshToken\", body.refresh_token);"
      ]}}],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"},
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      }
    },
    {
      "name": "List users",
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/users"
      }
    },
    {
      "name": "Create user",
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"user\"\n}"},
        "url": "{{baseUrl}}/api/v1/users"
      }
    },
    {
      "name": "Update user",
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"password\": \"{{testPassword}}\",\n  \"enabled\": true\n}"},
        "url": "{{baseUrl}}/api/v1/users/{{testUsername}}"
      }
    },
    {
      "name": "Get RTC",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"RTC returned\", () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body).to.have.property(\"synchronized\");",
        "pm.expect(body).to.have.property(\"unix_time\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/rtc"
      }
    },
    {
      "name": "Get temperature",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Temperature returned\", () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().sensors).to.be.an(\"array\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/temperature"
      }
    },
    {
      "name": "Get health-check configuration",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Configuration returned\", () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.expect(body.period_seconds).to.be.within(60, 1800);",
        "pm.expect(body.resources).to.be.an(\"array\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health-check/config"
      }
    },
    {
      "name": "Update health-check period",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Period updated\", () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().period_seconds).to.eql(60);"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"period_seconds\": 60\n}"},
        "url": "{{baseUrl}}/api/v1/health-check/config"
      }
    },
    {
      "name": "Create health-check resource",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Resource created\", () => pm.response.to.have.status(201));",
        "const body = pm.response.json();",
        "pm.collectionVariables.set(\"resourceIndex\", body.index);"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"host\": \"example.com\",\n  \"port\": 443,\n  \"path\": \"/\",\n  \"enabled\": false\n}"},
        "url": "{{baseUrl}}/api/v1/health-check/resources"
      }
    },
    {
      "name": "Update health-check resource",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Resource updated\", () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().enabled).to.eql(false);"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"path\": \"/health\",\n  \"enabled\": false\n}"},
        "url": "{{baseUrl}}/api/v1/health-check/resources/{{resourceIndex}}"
      }
    },
    {
      "name": "Get health-check logs",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Logs returned\", () => pm.response.to.have.status(200));",
        "const logs = pm.response.json().logs;",
        "pm.expect(logs).to.be.an(\"array\");",
        "pm.expect(logs.length).to.be.at.most(10);"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health-check/logs"
      }
    },
    {
      "name": "Delete health-check resource",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Resource deleted\", () => pm.response.to.have.status(200));",
        "pm.collectionVariables.unset(\"resourceIndex\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/health-check/resources/{{resourceIndex}}"
      }
    },
    {
      "name": "Upload TLS certificate (manual file selection may be required)",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Certificate staged or activated\", () => pm.expect([200, 202]).to.include(pm.response.code));"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/octet-stream"}],
        "body": {"mode": "file", "file": {"src": "{{certificateDerPath}}"}},
        "url": "{{baseUrl}}/api/v1/tls/certificate",
        "description": "Generate DER files with tools/convert_credentials_to_der.py. Postman may require selecting the file manually in the Body tab."
      }
    },
    {
      "name": "Upload TLS private key (manual file selection may be required)",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Credential pair activated\", () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().status).to.eql(\"activated\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "PUT",
        "header": [{"key": "Content-Type", "value": "application/octet-stream"}],
        "body": {"mode": "file", "file": {"src": "{{privateKeyDerPath}}"}},
        "url": "{{baseUrl}}/api/v1/tls/private-key",
        "description": "Run after the certificate upload. Postman may require selecting the file manually in the Body tab."
      }
    },
    {
      "name": "Delete user",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"User deleted\", () => pm.response.to.have.status(200));",
        "pm.expect(pm.response.json().deleted).to.eql(true);"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "DELETE",
        "url": "{{baseUrl}}/api/v1/users/{{testUsername}}"
      }
    },
    {
      "name": "Revoke token",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test(\"Session revoked\", () => pm.response.to.have.status(200));",
        "pm.collectionVariables.unset(\"accessToken\");",
        "pm.collectionVariables.unset(\"refreshToken\");"
      ]}}],
      "request": {
        "auth": {"type": "bearer", "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]},
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/auth/revoke"
      }
    }
  ]
}
