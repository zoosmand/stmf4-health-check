                "v1",
                "trust-anchors"
              ]
            },
            "description": "Upload one DER-encoded root CA certificate, at most 2048 bytes. Postman may require selecting the file manually."
          },
          "response": []
        },
        {
          "name": "Replace trust anchor (manual file selection may be required)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Trust anchor replaced\", () => pm.response.to.have.status(200));",
